# Stable autonomous prototype used by default
VITE_CONTOUR_DATA_MODE=mock

# Browser-facing API prefix. Prefer same-origin /api/v1 in production
VITE_CONTOUR_API_BASE_URL=/api/v1

# Show one-click hackathon demo profiles on the login screen.
# Keep false or unset outside a controlled demo environment.
VITE_SHOW_DEMO_CREDENTIALS=false

# Local Vite-only reverse proxy target. This variable is not exposed to client code
# CONTOUR_API_PROXY_TARGET=https://localhost:8443
