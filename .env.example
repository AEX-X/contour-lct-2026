# Copy to .env only when you need to override a default. This file contains
# development defaults, not production secrets.

POSTGRES_USER=mkl
POSTGRES_PASSWORD=mkl
POSTGRES_DB=mkl
LOG_LEVEL=INFO

# SMVU replay engine (docs/adr/0005): how fast the emulated background
# telemetry stream advances through the real operational window.
REPLAY_SPEED_MULTIPLIER=360.0
REPLAY_TICK_SECONDS=5.0

# Login session lifetime; an expired bearer token gets 401 SESSION_EXPIRED.
SESSION_TTL_MINUTES=480

# Brute-force protection: failed logins per username / per client IP
# inside the window that lock further attempts with 429.
LOGIN_MAX_FAILURES_PER_USERNAME=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# Browser origins of the frontend allowed to call the API, comma-separated
# (e.g. http://localhost:5173). The bundled frontend is same-origin, so CORS
# remains disabled by default. Never use "*" outside a disposable demo.
CORS_ALLOWED_ORIGINS=

# ML team's model-quality JSON, served by /api/v1/model-quality when the ML
# service is not reachable (path relative to the repository root).
ML_QUALITY_FILE=ml/outputs/ml-baseline-v2/validate-stability.json

# TLS proxy (docker compose): host ports. The API is served only over
# HTTPS (TLS 1.2+) on HTTPS_PORT; HTTP_PORT answers with a redirect.
HTTPS_PORT=8443
HTTP_PORT=8080

# One-click local demo accounts on the login screen. Set false for any
# environment where credentials must not be embedded in the frontend bundle.
VITE_SHOW_DEMO_CREDENTIALS=true

# Full mode only. The folder is bind-mounted read-only and must contain
# 2019.parquet through 2026.parquet. Relative paths are resolved from the repo.
ML_DATA_DIR=./ml-data
ML_DEMO_ANCHOR=2026-06-20T00:00:00
